// WistAgentd 子系统用例

// 注册管理中心
usecase RegisterWithManagementCenter {
  meta {
    label zh "注册管理中心"
    label en "Register With Management Center"
    tags "agent-register", "wp-agent"
  }

  actor Control.Agentd
  trigger Control.SubmitEnrollmentRequest
  outcome Control.AgentIdentity, Control.AgentEnrollmentResult
  flow Control.AgentdRegistrationFlow
  verify Control.AgentdRegistrationVerified
}

// 定期上报自己状态
usecase PeriodicallyReportSelfStatus {
  meta {
    label zh "定期上报自己状态"
    label en "Periodically Report Self Status"
    tags "agent-health", "wp-agent"
  }

  actor Control.Agentd
  trigger Reporting.AgentHello
  outcome Reporting.RuntimeHealthSnapshot
  flow Reporting.AgentHelloFlow
  verify Reporting.AgentHelloVerified
}

// 采集日志
usecase CollectLogs {
  meta {
    label zh "采集日志"
    label en "Collect Logs"
    tags "log-collection", "wp-agent"
  }

  actor Discovery.Collector
  trigger Discovery.CollectLogs
  outcome Discovery.TelemetryBuffer
}

// 采集 Metric
usecase CollectMetrics {
  meta {
    label zh "采集 Metric"
    label en "Collect Metrics"
    tags "metric-collection", "wp-agent"
  }

  actor Discovery.Collector
  trigger Discovery.CollectMetrics
  outcome Discovery.MetricsSamplesSnapshot
}

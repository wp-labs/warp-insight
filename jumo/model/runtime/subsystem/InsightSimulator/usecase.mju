// InsightSimulator 子系统用例
//
// 仿真器扮演已有 actor（Control.WarpGateway / Control.Agentd），复用模型既有命令与
// 回执，向各自上层节点发数据，用于联调中心/网关联收链路与状态展示。

// ── Gateway 角色（上游：WistCenter） ──

// 模拟Gateway状态上报
usecase SimulateGatewayStatusReport {
  meta {
    label zh "模拟 Gateway 状态上报"
    label en "Simulate Gateway Status Report"
    tags "simulator", "gateway", "status"
  }

  actor Control.WarpGateway
  trigger Control.ReportGatewayStatus
  outcome Control.GatewayStatusAccepted
}

// 模拟拉取Gateway初始配置
usecase SimulateGetGatewayInitialConfig {
  meta {
    label zh "模拟拉取 Gateway 初始配置"
    label en "Simulate Get Gateway Initial Config"
    tags "simulator", "gateway", "bootstrap"
  }

  actor Control.WarpGateway
  trigger Control.GetGatewayInitialConfig
  outcome Control.GatewayInitialConfig
}

// ── Agentd 角色（上游：WarpGateway） ──

// 模拟Agent状态上报
usecase SimulateAgentStatusReport {
  meta {
    label zh "模拟 Agentd 状态上报"
    label en "Simulate Agentd Status Report"
    summary zh "仿真器扮演 WistAgentd，向 WarpGateway 上报 Agent 运行状态（AgentHello）。"
    tags "simulator", "agentd", "status"
  }

  actor Control.Agentd
  trigger Reporting.AgentHello
  outcome Reporting.RuntimeHealthSnapshot
}

// 模拟Agent动作结果上报
usecase SimulateActionResultReport {
  meta {
    label zh "模拟 Agentd 动作结果上报"
    label en "Simulate Agentd Action Result Report"
    summary zh "仿真器扮演 WistAgentd，向 WarpGateway 上报动作执行结果（ReportActionResult）。"
    tags "simulator", "agentd", "action-result"
  }

  actor Control.Agentd
  trigger Reporting.ReportActionResult
  outcome Reporting.ActionResultReceipt
}

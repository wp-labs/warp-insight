// WistCenter WEB Layout index
//
// 每页只实现一个目标：
// - GatewayListPage      查看网关列表状态（ViewGatewayStatus）
// - GatewayInstancePage   网关实例管理（CreateGatewayInstance / BindGatewayCustomer）
// - GatewayConfigPage     网关初始配置查询（GetInitialConfig）
// - ReleasePage           版本发布（PublishWistAgentd / PublishWarpGateway）
// - UpgradePlanPage       升级计划管理（CreateUpgradePlan / ApproveUpgradePlan）
// ReceiveGatewayStatusReport 为系统上报（WarpGateway 后台），喂给状态展示，无独立页面。

region GlobalTopNavigation {
  meta {
    label zh "顶部导航"
    label en "Top Navigation"
    summary zh "WistCenter 的顶部导航区，作为各页面共享的页面级导航，提供网关列表、网关实例、配置、发布与升级计划入口。"
    tags "center", "navigation", "top-navigation", "layout-index"
  }

  orientation horizontal
}

// ── 目标 1：查看网关列表状态 ──

region<page> GatewayListPage {
  meta {
    label zh "网关列表"
    label en "Gateway List"
    summary zh "查看各 WarpGateway 实例的在线状态、版本、健康状态与最后上报时间。"
    tags "center", "gateway", "list", "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains GatewayStatusList { slot_usecase: ViewGatewayStatus }
  layout fill_remaining
}

region<section> GatewayStatusList {
  meta {
    label zh "网关列表状态列表"
    label en "Gateway List Status List"
    summary zh "按卡片展示各 WarpGateway 实例的状态摘要。"
    tags "center", "gateway", "status", "list"
  }

  orientation vertical
  repeat GatewayStatusCard for gateway in GatewayRuntimeStatus
  layout scrollable
}

region<section> GatewayStatusCard {
  meta {
    label zh "网关状态卡片"
    label en "Gateway Status Card"
    tags "center", "gateway", "status", "card"
  }

  orientation grid
  contains GatewayInstanceText { area: gateway_instance_text, row: 1, col: 1, width: 100%, slot_field: instance_id }
  contains GatewayVersionText { area: gateway_version_text, row: 2, col: 1, width: 50%, slot_field: version }
  contains GatewayOnlineStatusBadge { area: gateway_online_status_badge, row: 3, col: 1, width: 50%, slot_field: status }
  contains GatewayHealthBadge { area: gateway_health_badge, row: 4, col: 1, width: 50%, slot_field: health }
  contains GatewayLastSeenAtText { area: gateway_last_seen_at_text, row: 5, col: 1, width: 100%, slot_field: last_seen_at }
}

// ── 目标 2：网关实例管理（创建与绑定客户） ──

region<page> GatewayInstancePage {
  meta {
    label zh "网关实例管理"
    label en "Gateway Instance Management"
    summary zh "创建 Gateway 管理实例并为实例绑定客户 ID。"
    tags "center", "gateway", "instance", "provisioning", "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains GatewayInstanceCreatePanel { slot_usecase: CreateGatewayInstance }
  contains GatewayCustomerBindPanel { slot_usecase: BindGatewayCustomer }
  layout fill_remaining
}

region<section> GatewayInstanceCreatePanel {
  meta {
    label zh "创建网关实例"
    label en "Create Gateway Instance"
    summary zh "客户服务工程师创建 Gateway 管理实例的入口。"
    tags "center", "gateway", "provisioning"
  }

  orientation vertical
}

region<section> GatewayCustomerBindPanel {
  meta {
    label zh "绑定客户"
    label en "Bind Gateway Customer"
    summary zh "客户服务工程师为 Gateway 管理实例绑定客户 ID 的入口。"
    tags "center", "gateway", "customer"
  }

  orientation vertical
}

// ── 目标 3：网关初始配置查询 ──

region<page> GatewayConfigPage {
  meta {
    label zh "网关初始配置"
    label en "Gateway Initial Config"
    summary zh "查看指定 WarpGateway 实例的初始配置信息（控制中心地址、策略版本、遥测输出）。"
    tags "center", "gateway", "config", "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains GatewayInitialConfigPanel { slot_usecase: GetInitialConfig }
  layout fill_remaining
}

region<section> GatewayInitialConfigPanel {
  meta {
    label zh "初始配置详情"
    label en "Gateway Initial Config Detail"
    summary zh "展示网关初始配置：控制中心地址、策略版本与遥测输出。"
    tags "center", "gateway", "config"
  }

  orientation vertical
}

// ── 目标 4：版本发布 ──

region<page> ReleasePage {
  meta {
    label zh "版本发布"
    label en "Release"
    summary zh "发布 WistAgentd / WarpGateway 新版本，供各 WarpGateway 实例或管理实例升级。"
    tags "center", "release", "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains WistAgentdReleasePanel { slot_usecase: PublishWistAgentd }
  contains WarpGatewayReleasePanel { slot_usecase: PublishWarpGateway }
  layout fill_remaining
}

region<section> WistAgentdReleasePanel {
  meta {
    label zh "WistAgentd 发布"
    label en "Publish WistAgentd"
    summary zh "平台维护工程师发布 WistAgentd 新版本。"
    tags "center", "release", "wist-agentd"
  }

  orientation vertical
}

region<section> WarpGatewayReleasePanel {
  meta {
    label zh "WarpGateway 发布"
    label en "Publish WarpGateway"
    summary zh "平台维护工程师发布 WarpGateway 新版本。"
    tags "center", "release", "warp-gateway"
  }

  orientation vertical
}

// ── 目标 5：升级计划管理（创建与批准） ──

region<page> UpgradePlanPage {
  meta {
    label zh "升级计划"
    label en "Upgrade Plan"
    summary zh "创建与批准 WistAgentd / WarpGateway 升级计划。"
    tags "center", "release", "upgrade", "page"
  }

  orientation vertical
  contains GlobalTopNavigation
  contains UpgradePlanCreatePanel { slot_usecase: CreateUpgradePlan }
  contains UpgradePlanApprovePanel { slot_usecase: ApproveUpgradePlan }
  layout fill_remaining
}

region<section> UpgradePlanCreatePanel {
  meta {
    label zh "创建升级计划"
    label en "Create Upgrade Plan"
    summary zh "平台维护工程师创建升级计划，指定目标组件、目标版本与升级范围。"
    tags "center", "release", "upgrade"
  }

  orientation vertical
}

region<section> UpgradePlanApprovePanel {
  meta {
    label zh "批准升级计划"
    label en "Approve Upgrade Plan"
    summary zh "客户服务工程师批准升级计划。"
    tags "center", "release", "upgrade"
  }

  orientation vertical
}

// ── 卡片输出区域 ──

region GatewayInstanceText {
  meta {
    label zh "网关实例"
    label en "Gateway Instance"
    summary zh "展示网关实例 ID。"
    tags "center", "output"
  }

  orientation vertical
}

region GatewayVersionText {
  meta {
    label zh "网关版本"
    label en "Gateway Version"
    summary zh "展示网关运行版本。"
    tags "center", "output"
  }

  orientation vertical
}

region GatewayOnlineStatusBadge {
  meta {
    label zh "在线状态"
    label en "Gateway Online Status"
    summary zh "展示网关在线状态徽标。"
    tags "center", "output"
  }

  orientation vertical
}

region GatewayHealthBadge {
  meta {
    label zh "健康状态"
    label en "Gateway Health"
    summary zh "展示网关健康状态徽标。"
    tags "center", "output"
  }

  orientation vertical
}

region GatewayLastSeenAtText {
  meta {
    label zh "最后上报时间"
    label en "Last Seen At"
    summary zh "展示网关最后上报时间。"
    tags "center", "output"
  }

  orientation vertical
}

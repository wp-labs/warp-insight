// WistCenter 子系统用例
//
// 网关级事实（Control.WarpGateway、Control.GatewayOperator 及 GatewaySupervision
// 模块下的 command/struct）在 Control 域 gateway-supervision.mju 中建模。

// 创建网关实例
usecase CreateGatewayInstance {
  meta {
    label zh "创建网关实例"
    label en "Create Gateway Instance and Issue Bootstrap Token"
    summary zh "创建 Gateway 管理实例并签发一次性置备引导 Token（含控制中心信任根）；初始配置内容由网关调 initial-config 时即时生成（GetInitialConfig）。"
    tags "gateway", "provisioning", "config"
  }

  actor Control.BusinessAdministrator
  trigger Control.AdminCreateGatewayInstance
  outcome Control.GatewayInstance
  outcome Control.GatewayBootstrapToken
  flow Control.AdminCreateGatewayInstanceFlow
}

// 绑定客户ID
usecase BindGatewayCustomer {
  meta {
    label zh "绑定客户 ID"
    label en "Bind Gateway Customer"
    tags "gateway", "provisioning", "customer"
  }

  actor Control.BusinessAdministrator
  trigger Control.AdminBindGatewayCustomer
  outcome Control.GatewayCustomerBinding
}

// 发布WistAgentd
usecase PublishWistAgentd {
  meta {
    label zh "发布 WistAgentd"
    label en "Publish WistAgentd"
    tags "release", "wist-agentd"
  }

  actor Control.PlatformMaintenanceEngineer
  trigger Control.PublishWistAgentd
  outcome Control.WistAgentdRelease
}

// 发布WarpGateway
usecase PublishWarpGateway {
  meta {
    label zh "发布 WarpGateway"
    label en "Publish WarpGateway"
    tags "release", "warp-gateway"
  }

  actor Control.PlatformMaintenanceEngineer
  trigger Control.PublishWarpGateway
  outcome Control.WarpGatewayRelease
}

// 创建升级计划
usecase CreateUpgradePlan {
  meta {
    label zh "创建升级计划"
    label en "Create Upgrade Plan"
    tags "release", "upgrade"
  }

  actor Control.PlatformMaintenanceEngineer
  trigger Control.CreateUpgradePlan
  outcome Control.UpgradePlan
}

// 批准升级计划
usecase ApproveUpgradePlan {
  meta {
    label zh "批准升级计划"
    label en "Approve Upgrade Plan"
    tags "release", "upgrade"
  }

  actor Control.CustomerServiceEngineer
  trigger Control.ApproveUpgradePlan
  outcome Control.UpgradePlanApproval
}

// 获取初始配置信息
usecase GetInitialConfig {
  meta {
    label zh "获取初始配置信息"
    label en "Get Initial Config"
    tags "gateway", "bootstrap", "config"
  }

  actor Control.WarpGateway
  trigger Control.GetGatewayInitialConfig
  outcome Control.GatewayInitialConfig
  flow Control.GetGatewayInitialConfigFlow
}

// 续期网关运行期凭据
usecase RenewGatewayCredential {
  meta {
    label zh "续期网关运行期凭据"
    label en "Renew Gateway Credential"
    summary zh "网关凭当前运行期凭据申请新的 RUNTIME 凭据，旧凭据立即失效，实现定期轮换。"
    tags "gateway", "credential", "renewal"
  }

  actor Control.WarpGateway
  trigger Control.RenewGatewayCredential
  outcome Control.GatewayCredentialBundle
  flow Control.RenewGatewayCredentialFlow
}

// 接收Gateway状态上报
usecase ReceiveGatewayStatusReport {
  meta {
    label zh "接收 Gateway 状态上报"
    label en "Receive Gateway Status Report"
    tags "gateway", "status", "aggregation"
  }

  actor Control.WarpGateway
  trigger Control.ReportGatewayStatus
  outcome Control.GatewayStatusAccepted
}

// 查看Gateway状态
usecase ViewGatewayStatus {
  meta {
    label zh "查看Gateway状态"
    label en "View Gateway Status"
    tags "gateway", "status", "global-view"
  }

  actor Control.CustomerServiceEngineer
  trigger Control.AdminShowGatewayStatus
  outcome Control.GatewayRuntimeStatus
}

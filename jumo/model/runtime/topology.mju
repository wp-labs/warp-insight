// warp-insight 部署视图

node WarpGatewayHost {
  meta {
    label zh "WarpGateway节点"
    label en "WarpGateway Host"
    summary zh "在线业务区内的 WarpGateway 控制平台节点，运行 WarpGateway 前端 WEB、后端 WEB 服务接口和控制中心；数据平台能力由托管服务区承载。WarpGateway 实例接入上级 WistCenter 聚合控制中心，接收全局策略与控制指令。"
    tags "center", "online-business-zone", "control-plane", "warp-gateway"
  }
}

node AgentHost1 {
  meta {
    label zh "业务节点1"
    label en "Agent Host 1"
    summary zh "在线业务区内已经存在的业务服务器节点，安装 WistAgentd 后运行其 wist-agentd 守护进程与 wist-upgrader，集成本机 OS、进程、网络、容器运行时、业务日志、本地状态与 spool 资源，负责本地发现、采集、缓冲、上送和受控升级。"
    tags "edge", "online-business-zone", "existing-host"
  }
}

node AgentHost2 {
  meta {
    label zh "现有业务服务器节点 2"
    label en "Agent Host 2"
    summary zh "在线业务区内已经存在的业务服务器节点，安装 WistAgentd 后运行其 wist-agentd 守护进程与 wist-upgrader，集成本机 OS、进程、网络、容器运行时、业务日志、本地状态与 spool 资源，负责本地发现、采集、缓冲、上送和受控升级。"
    tags "edge", "online-business-zone", "existing-host"
  }
}

node ManagedServiceHost {
  meta {
    label zh "托管服务节点"
    label en "Managed Service Host"
    summary zh "托管服务区内的高信任节点，后续承载 WarpInsight 托管服务（数据平台等）。"
    tags "managed-service-zone", "center", "managed-service"
  }
}

module<adapter> AgentHost1ControlClient {
  meta {
    label zh "AgentHost1 控制客户端"
    label en "AgentHost1 Control Client"
    tags "topology-helper", "control-link"
  }

  depends Control.Protocol
}

module<adapter> AgentHost2ControlClient {
  meta {
    label zh "AgentHost2 控制客户端"
    label en "AgentHost2 Control Client"
    tags "topology-helper", "control-link"
  }

  depends Control.Protocol
}

module<adapter> ManagedServiceHostControlClient {
  meta {
    label zh "托管服务节点控制客户端"
    label en "Managed Service Host Control Client"
    tags "topology-helper", "control-link"
  }

  depends Control.Protocol
}

network OnlineBusinessZone {
  ingress controlled_internal
  trust_level business_internal
  contains WarpGatewayHost
  contains AgentHost1
  contains AgentHost2
}

network ManagedServiceZone {
  meta {
    label zh "托管服务区"
    label en "Managed Service Zone"
    summary zh "承载 WarpInsight 托管服务的高信任网络分区。"
  }
  ingress internal_only
  trust_level internal
  contains ManagedServiceHost
}

// 拓扑辅助绑定：为节点连线提供模块依赖依据，不作为节点内 target 展示。
bind AgentHost1ControlClient to AgentHost1 with topology
bind AgentHost2ControlClient to AgentHost2 with topology
bind ManagedServiceHostControlClient to ManagedServiceHost with topology
// Agent 主机部署 WistAgentd：先绑 agent 数据面模块，再绑管理节点，使控制面模块
// 最终归属管理节点，Agent 节点保留 Discovery/Observed/Reporting 数据面。
bind wist-agentd-bin to AgentHost1 with topology
bind wist-agentd-bin to AgentHost2 with topology
bind gateway-web to WarpGatewayHost with topology
bind warp-gateway to WarpGatewayHost with topology

// 节点间关系：Agent 主动连接管理节点控制通道。
link<call> AgentHost1 -> WarpGatewayHost
link<call> AgentHost2 -> WarpGatewayHost
// 托管服务节点上的托管服务连接管理节点控制通道。
link<call> ManagedServiceHost -> WarpGatewayHost

struct DiscoverySnapshot {
  schema_version
  unique snapshot_id
  revision
  generated_at
  origins
  resources
  targets
}

struct DiscoveryOrigin {
  unique origin_id
  probe
  source
  observed_at
}

struct DiscoveryCacheMeta {
  schema_version
  unique snapshot_id
  revision
  generated_at
  origins
  last_success_at
  last_error
}

struct DiscoveredResource {
  unique resource_id
  kind
  origin_idx
  attributes
  discovered_at
  last_seen_at
  health
  source
}

struct DiscoveredTarget {
  unique target_id
  kind
  origin_idx
  resource_ref
  execution_hints
  state
}

struct CollectionCandidate {
  unique candidate_id
  target_ref
  collection_kind
  resource_ref
  execution_hints
  generated_at
}

struct StringKeyValue {
  key
  value
}

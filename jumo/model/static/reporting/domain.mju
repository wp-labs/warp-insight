// ═══════════════════════════════════════════
// Flow & Verify
// ═══════════════════════════════════════════

flow AgentStatusReportFlow {
  actor Control.Agentd
  trigger AgentStatusReport

  creates RuntimeHealthSnapshot

  step<stop> ReportHealth {
    create RuntimeHealthSnapshot {
      state = AgentStatusReport.agent_id
      updated_at = AgentStatusReport.version
    }
  }
}

flow ReportActionResultFlow {
  actor Control.Agentd
  trigger ReportActionResult

  creates ActionResultReceipt

  step<stop> AcceptActionResult {
    create ActionResultReceipt {
      report_id = ReportActionResult.report_id
      agent_id = ReportActionResult.agent_id
      accepted_at = ReportActionResult.reported_at
    }
  }
}

verify AgentStatusReportVerified for flow AgentStatusReportFlow {
  given {
    AgentStatusReport.agent_id = "agent-001"
    AgentStatusReport.version = "v1"
  }

  when AgentStatusReport

  expect {
    RuntimeHealthSnapshot.state == "agent-001"
  }
}

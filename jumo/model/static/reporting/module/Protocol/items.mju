message<command> AgentStatusReport {
  agent_id: String
  instance_id: String
  version: String
  memory_bytes: Int?
  cpu_percent: Float?
  admin_latency_ms: Int?
}

message<response> AgentStatusAccepted {
  snapshot: RuntimeHealthSnapshot
}

command DispatchActionPlan {
  api_version
  kind
  unique dispatch_id
  plan
}

event ActionPlanAck {
  api_version
  kind
  dispatch_id
  action_id
  plan_digest
  agent_id
  instance_id
  execution_id
  ack_status
  reason_code
  reason_message
  queue_position
  received_at
  acknowledged_at
}

struct AckStatus {
  variant
}

struct ActionPlanAckBuilder {
  dispatch_id
  action_id
  plan_digest
  agent_id
  instance_id
  execution_id
  ack_status
  reason_code
  reason_message
  queue_position
  received_at
  acknowledged_at
}

message<command> ReportActionResult {
  api_version: String
  unique report_id: String
  kind: String
  dispatch_id: String
  action_id: String
  report_attempt: Int
  final_status: String
  execution_id: String
  plan_digest: String
  agent_id: String
  instance_id: String
  result_attestation: ResultAttestation
  reported_at: DateTime
  result: String
}

message<response> ActionResultAccepted {
  receipt: ActionResultReceipt
}

struct ActionResultReceipt {
  report_id: String
  agent_id: String
  accepted_at: DateTime
}

struct ResultAttestation {
  result_digest: String
  signature: String
  issued_by: String
  attested_at: DateTime
}

command ReportDiscoverySnapshot {
  api_version
  kind
  unique report_id
  agent_id
  instance_id
  mode
  snapshot
  reported_at
}

struct DiscoveryReportMode {
  variant
}

event DiscoveryIngestAck {
  report_id
  status
  ingested_resources
  ingested_targets
  received_at
  ack_at
}

struct DiscoveryIngestAckStatus {
  variant
}

event IngestHeadError {
  reason
  detail
}

struct ActionPlan {
  api_version
  kind
  plan_meta
  target
  constraints
  program
}

struct ActionPlanMeta {
  unique action_id
  request_id
  template_id
  tenant_id
  environment_id
  plan_version
  compiled_at
  expires_at
}

struct ActionPlanTarget {
  agent_id
  instance_id
  node_id
  host_name
  platform
  arch
  selectors
}

struct ActionPlanConstraints {
  risk_level
  approval_ref
  approval_mode
  requested_by
  reason
  max_total_duration_ms
  step_timeout_default_ms
  execution_profile
  required_capabilities
}

struct RiskLevel {
  level
}

struct ApprovalMode {
  mode
}

struct ActionPlanProgram {
  entry
  steps
}

struct ActionPlanStep {
  unique id
  kind
  op
}

struct ActionResult {
  api_version
  kind
  action_id
  execution_id
  request_id
  final_status
  exit_reason
  step_records
  outputs
  resource_usage
  started_at
  finished_at
}

struct FinalStatus {
  variant
}

struct StepActionRecord {
  unique step_id
  attempt
  op
  status
  started_at
  finished_at
  duration_ms
  error_code
  stdout_summary
  stderr_summary
  resource_usage
}

struct StepStatus {
  variant
}

struct ActionOutputs {
  items
}

struct ActionOutputItem {
  name
  value
  redacted
}

struct ExecutionResourceUsage {
  max_rss_bytes
  cpu_time_ms
  stdout_bytes
  stderr_bytes
}

struct CapabilityReport {
  schema_version
  agent_id
  instance_id
  version
  generated_at
  sections
}

struct CapabilityReportSections {
  exec
  metrics
  logs
  upgrade
  limits
}

struct ExecCapabilities {
  supported
  max_concurrent
  cancel_supported
}

struct MetricsCapabilities {
  supported
  collection_kinds
}

struct LogsCapabilities {
  supported
  input_kinds
  output_kinds
}

struct UpgradeCapabilities {
  supported
  stage_kinds
}

struct CapabilityLimits {
  max_stdout_bytes
  max_stderr_bytes
  max_duration_ms
}

struct TelemetryRecordContract {
  api_version
  kind
  unique record_id
  agent_id
  instance_id
  collected_at
}

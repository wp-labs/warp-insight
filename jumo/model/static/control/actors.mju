// Control domain actors

actor<system> Agentd {
  meta {
    label zh "WistAgentd 守护进程"
    label en "WistAgentd Daemon"
    summary zh "运行在业务服务器上的 wist-agentd 守护进程，作为系统 actor 发起注册、凭据轮换、状态上报与控制指令轮询。"
    tags "edge", "agentd", "daemon"
  }

  access protocol<http>
  can SubmitEnrollmentRequest
  can RenewAgentCredential
  can VerifyAgentCredential
  can PollControlCommands
  can AgentUpstreamMessage
  can Reporting.AgentHello
  can Reporting.ReportActionResult
}

actor OperationsEngineer {
  meta {
    label zh "运维工程师"
    label en "Operations Engineer"
    tags "ops", "agent-install"
  }

  access protocol<http>
  can GetAgentInstallCode
  can AdminGetAgentInstallCode
}

actor AdminOperator {
  access protocol<http>
  can GetAgentOverview
  can ShowAgentRuntimeStatus
  can PauseAgent
  can UpgradeAgent
  can AdminGetAgentOverview
  can AdminShowAgentRuntimeStatus
  can AdminPauseAgent
  can AdminUpgradeAgent
  can ViewGatewayOverview
  can DispatchAgentFleetCommand
  can AdminViewGatewayManagementState
  can AdminGetGatewayInitialConfig
  can AdminLookupAgentRegistryEntry
  can AdminQueryAgentCapabilityIndex
}

actor<system> WarpGateway {
  meta {
    label zh "WarpGateway 实例"
    label en "Warp Gateway Instance"
    summary zh "接入 WistCenter 的一个 WarpGateway 实例，作为系统 actor 获取初始配置并定期上报状态。"
    tag "gateway"
  }

  access protocol<http>
  can RegisterGateway
  can VerifyGatewayCredential
  can RenewGatewayCredential
  can GetGatewayInitialConfig
  can ReportGatewayStatus
  can ReportAgentStatus
}

actor GatewayOperator {
  meta {
    label zh "全局操作者"
    label en "Gateway Operator"
    tags "gateway", "ops"
  }

  access protocol<http>
  can AdminViewGatewayList
}

actor BusinessAdministrator {
  meta {
    label zh "业务管理员"
    label en "Business Administrator"
    summary zh "负责网关开通的中心侧业务管理员：创建网关实例、获取置备引导 Token。"
    tags "gateway", "provisioning", "business-admin"
  }

  access protocol<http>
  can AdminCreateGatewayInstance
  can GetGatewayInitialConfig
  can AdminGetGatewayInitialConfig
  can AdminViewGatewayList
  can AdminListGatewayInstances
  can AdminBindGatewayCustomer
}

actor CustomerServiceEngineer {
  meta {
    label zh "客户服务工程师"
    label en "Customer Service Engineer"
    tags "ops", "customer-service", "gateway"
  }

  access protocol<http>
  can GatewayContainerInstallRequested
  can GatewayImageDownloadRequested
  can GetGatewayInitialConfig
  can InitializeGatewayViaUrl
  can ApproveUpgradePlan
  can AdminShowGatewayStatus
  can AdminListGatewayStatus
}

actor PlatformMaintenanceEngineer {
  meta {
    label zh "平台维护工程师"
    label en "Platform Maintenance Engineer"
    tags "ops", "platform-maintenance", "release"
  }

  access protocol<http>
  can PublishWistAgentd
  can PublishWarpGateway
  can CreateUpgradePlan
  can AdminDispatchGlobalPolicy
  can AdminListGatewayInstances
  can AdminGetGatewayUptime
  can AdminGetGatewayHistory
  can AdminGetAgentHistory
  can AdminListGatewayAgents
  can AdminGetGatewayLifecycle
  can AdminGetGatewayInitialConfig
  can AdminPublishRelease
  can AdminListReleases
  can AdminCreateUpgradePlan
  can AdminListUpgradePlans
  can AdminApproveUpgradePlan
}

actor PublicInstallClient {
  meta {
    label zh "公开安装客户端"
    label en "Public Install Client"
    tags "install", "client"
  }

  access protocol<http>
}

// Module: AgentIdentity — Agent 身份与凭据生命周期
// 身份/凭据实体事实；续期、校验命令与流程由 AgentCredential 承载。

struct AgentIdentity {
  meta {
    label zh "Agent 身份"
    label en "Agent AgentIdentity"
    summary zh "Agentd 注册后由管理端签发的稳定身份，绑定租户、环境、节点和凭据状态。"
    tags "agentd", "identity"
  }

  unique agent_id: String
  instance_id: String
  tenant_id: String
  environment_id: String
  node_id: String
  issued_at: DateTime
  expires_at: DateTime
  status: AgentIdentityStatus
}

variant AgentIdentityStatus {
  meta {
    label zh "Agent 身份状态"
    label en "Agent AgentIdentity Status"
    summary zh "描述 Agentd 身份是否有效、吊销、过期或待续期。"
    tags "agentd", "identity"
  }

  Active
  Revoked
  Expired
  RenewalRequired
}

struct HostProfile {
  meta {
    label zh "Agent 宿主机画像"
    label en "Agent Host Profile"
    tags "agentd", "host"
  }

  unique node_id: String
  hostname: String
  os: String
  arch: String
  machine_id: String
  cloud_instance_id: String
  k8s_node_uid: String
  ip_addresses: List<String>
}

struct CredentialBundle {
  meta {
    label zh "Agent 凭据包"
    label en "Agent Credential Bundle"
    tags "agentd", "credential"
  }

  unique credential_id: String
  agent_id: String
  instance_id: String
  auth_scheme: String
  bearer_token: Secret
  certificate: String
  private_key_ref: String
  ca_bundle: String
  issued_at: DateTime
  not_before: DateTime
  not_after: DateTime
}

struct AgentControlAuthProfile {
  meta {
    label zh "Agent 控制通道认证配置"
    label en "Agent Control Auth Profile"
    tags "control", "auth"
  }

  server_tls_required: Bool
  agent_credential_required: Bool
  mtls_client_certificate_allowed: Bool
  credential_expiration_enforced: Bool
  enrollment_token_rejected: Bool
}

struct AgentCredentialVerificationResult {
  meta {
    label zh "Agent 凭据校验结果"
    label en "Agent Credential Verification Result"
    tags "agentd", "credential", "verification"
  }

  agent_id: String
  instance_id: String
  status: AgentCredentialVerificationStatus
  reason_code: String
  verified_at: DateTime
}

variant AgentCredentialVerificationStatus {
  Verified
  UnknownAgent
  CredentialMissing
  CredentialExpired
  CredentialRevoked
  CredentialMismatch
}

event AgentCredentialIssued {
  agent_id
  instance_id
  credential
  issued_at
}

event AgentCredentialRevoked {
  agent_id
  instance_id
  reason_code
  revoked_at
}

event AgentCredentialVerified {
  agent_id
  instance_id
  verified_at
}

event AgentCredentialRejected {
  agent_id
  instance_id
  reason_code
  rejected_at
}

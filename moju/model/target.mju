// warp-insight 生成与部署目标

target<site,web> warp-insight-admin-web {
  modules Control.AdminWebFrontend
}

target<bin,http> warp-insight-admin {
  modules Control.UserFacingInterface, Control.AgentFacingInterface
  modules Control.Enrollment, Control.Identity, Control.AgentdStatusManagement
  modules Control.AgentCommandControl
  modules Control.Protocol, Control.Registry
  modules Reporting.Protocol
}

target<bin> warp-insightd {
  modules Control.AgentFacingInterface, Control.Enrollment, Control.Identity
  modules Control.AgentCommandControl, Control.Protocol, Control.Registry
  modules Discovery.Config, Discovery.Probe, Discovery.Collect, Discovery.Execute
  modules Observed.Snapshot, Observed.Entity
  modules Reporting.Protocol, Reporting.Contract, Reporting.Health, Reporting.Pipeline
}

target<bin> warp-insight-upgrader {
  modules Discovery.Execute, Reporting.Contract
}

target<platform> warp-insight-managed {
  subsystem WarpInsightAdmin
  subsystem DataPlatform
  subsystem WpAgent
}

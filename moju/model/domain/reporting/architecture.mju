// 上报域 architecture

layer Application
layer Domain
layer Infra

dependency_rule LayerDirection {
  Application -> Domain
  Domain -> Infra
  Infra -> none_external
}

module<interface> Protocol {
  meta {
    label zh "上报协议"
    label en "Reporting Protocol"
    summary zh "负责 Agent hello、action 派发 ACK、执行结果上报、发现快照上报和 ingest ACK。"
    tag "reporting"
    tag "protocol"
    tag "interface"
  }

  layer Application
  owns AgentHello
  owns AgentStatusAccepted
  owns DispatchActionPlan
  owns ActionPlanAck
  owns AckStatus
  owns ActionPlanAckBuilder
  owns ReportActionResult
  owns ActionResultAccepted
  owns ActionResultReceipt
  owns ResultAttestation
  owns ReportDiscoverySnapshot
  owns DiscoveryReportMode
  owns DiscoveryIngestAck
  owns DiscoveryIngestAckStatus
  owns IngestHeadError
  responsible_for "与控制面的通信协议：Gateway 握手/派发/ACK/上报 + Ingest 快照上报"
}

module Contract {
  meta {
    label zh "上报数据契约"
    label en "Reporting Contract"
    summary zh "负责 action 计划、执行结果、能力报告、资源使用、遥测记录等上报数据结构。"
    tag "reporting"
    tag "contract"
  }

  layer Domain
  owns ActionPlanContract
  owns ActionPlanMeta
  owns ActionPlanTarget
  owns ActionPlanConstraints
  owns RiskLevel
  owns ApprovalMode
  owns ActionPlanProgram
  owns ActionPlanStep
  owns ActionResultContract
  owns FinalStatus
  owns StepActionRecord
  owns StepStatus
  owns ActionOutputs
  owns ActionOutputItem
  owns ExecutionResourceUsage
  owns CapabilityReportContract
  owns CapabilityReportSections
  owns ExecCapabilities
  owns MetricsCapabilities
  owns LogsCapabilities
  owns UpgradeCapabilities
  owns CapabilityLimits
  owns TelemetryRecordContract
  responsible_for "业务数据契约：Action 计划/结果、能力上报、遥测记录"
}

module<service> Health {
  meta {
    label zh "Agent 健康"
    label en "Agent Health"
    summary zh "负责 Agent 自观测健康、发现健康、Metric 健康、运行时快照和故障计数。"
    tag "reporting"
    tag "health"
  }

  layer Domain
  owns DiscoveryReadiness
  owns DiscoveryProbeHealth
  owns DiscoveryHealthSnapshot
  owns MetricsHealthSnapshot
  owns HealthState
  owns RuntimeHealthSnapshot
  owns MetricsTick
  owns MetricsFailureKind
  owns MetricsFailure
  owns TelemetryTick
  owns TelemetryFailureKind
  owns TelemetryFailure
  responsible_for "Agent 自观测与健康上报：发现健康、Metrics 健康、运行时快照、故障计数"
}

module<pipeline> Pipeline {
  meta {
    label zh "上报管线"
    label en "Reporting Pipeline"
    summary zh "负责报告准备、检查、导出、执行历史、Daemon 主循环和运行状态编排。"
    tag "reporting"
    tag "pipeline"
  }

  layer Application
  owns ReportingRequest
  owns PreparedReport
  owns PreparedReportOrigin
  owns LocalReportIssue
  owns LocalReportInspection
  owns ReportingState
  owns ExporterOutput
  owns ExporterSource
  owns ExportResult
  owns DiscRowContext
  owns ExecutionHistoryRecord
  owns DaemonLoop
  owns DiscoveryHealth
  owns SignalRequestKind
  owns RunningStateStatus
  responsible_for "上报管线与编排：报告准备/检查/导出、执行历史、Daemon 主循环"
}

// 发现采集域 (Discovery & Collection Domain) — HOW we observe

// ══════════════════════════════════════════════════════════
// Module: Config — Agent 配置
// ══════════════════════════════════════════════════════════

struct AgentConfigContract {
  unique schema_version
  agent
  control_plane
  paths
  execution
  telemetry
  discovery
}

struct AgentSection {
  agent_id
  environment_id
  instance_name
}

struct ControlPlaneSection {
  enabled
  endpoint
  tls_mode
  auth_mode
}

struct PathsSection {
  root_dir
  run_dir
  state_dir
  log_dir
}

struct ExecutionSection {
  max_running_actions
  cancel_grace_ms
  default_stdout_limit_bytes
  default_stderr_limit_bytes
}

struct DiscoverySection {
  host_enabled
  network_enabled
  endpoint_enabled
  process_enabled
  container_enabled
}

struct TelemetrySection {
  logs
}

struct LogsSection {
  file_inputs
  in_memory_buffer_bytes
  spool_dir
  output
}

struct LogsOutputSection {
  kind
  file
  tcp
}

struct LogsFileOutputSection {
  path
}

struct LogsTcpOutputSection {
  addr
  port
  framing
}

struct LogFileInputSection {
  unique input_id
  path
  startup_position
  multiline_mode
}

struct EnsuredConfigFile {
  path
}

struct ConfigError {
  detail
}

// ══════════════════════════════════════════════════════════
// Module: Probe — 发现探针与运行时
// ══════════════════════════════════════════════════════════

struct DiscoveryProbe {
}

struct HostDiscoveryProbe {
  kind
}

struct NetworkDiscoveryProbe {
  kind
}

struct EndpointDiscoveryProbe {
  kind
}

struct ProcessDiscoveryProbe {
  kind
}

struct ContainerDiscoveryProbe {
  kind
}

struct K8sDiscoveryProbe {
  kind
}

struct ProbeOutput {
  source
  probe
  resources
  targets
}

struct DiscoveryProbeError {
  source
  probe
  detail
}

struct DiscoveryRuntime {
  probes
}

struct DiscoveryRefreshResult {
  refreshed_snapshot
  persisted_snapshot
  used_cached_snapshot
  had_successful_refresh
  errors
  last_success_at
  last_error
  store_failure

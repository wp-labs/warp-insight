}

struct SchedulerOutcome {
  execution_id
  plan_digest
}

struct DrainRequest {
  run_dir
  state_dir
  exec_bin
  instance_id
  cancel_grace_ms
  stdout_limit_bytes
  stderr_limit_bytes
}

struct DrainOutcome {
  execution_id
  plan_digest
  report
}

struct QueueHeadContext {
  request
  item
}

struct QueueHeadDisposition {
  variant
}

struct ExecutionQueueState {
  items
}

struct ExecutionQueueItem {
  unique execution_id
  action_id
  plan_digest
  request_id
  enqueued_at
  deadline_at
  risk_level
}

struct ExecutionQueueItemBuilder {
  execution_id
  action_id
  plan_digest
  request_id
  enqueued_at
}

// ── 本地执行 ──

struct LocalExecRequest {
  workdir
  exec_bin
  cancel_grace_ms
  stdout_limit_bytes
  stderr_limit_bytes
}

struct LocalExecOutcome {
  execution_id
  exit_code
  stdout_bytes
  stderr_bytes
  duration_ms
}

struct ExitClassification {
  exit_code
  timed_out
  cancelled
}

struct QuarantineRequest {
  execution_id
  reason
}

// ── 运行时状态 ──

state RunningExecutionState {
  execution_id
  action_id
  plan_digest
  spawned_at
  pid
  status
}

struct RunningExecutionStateBuilder {
  execution_id
  action_id
  plan_digest
}

struct ProcessIdentityState {
  pid
  start_time
}

state AgentRuntimeState {
  schema_version
  agent_id
  instance_id
  version
  mode
  updated_at
}

struct RuntimeMode {
  variant
}

struct ExecRuntimeContext {
  unique execution_id
  spawned_at
  deadline_at
  agent_id
  node_id
  workdir
}

state ExecProgressState {
  execution_id
  action_id
  state
  updated_at
  step_id
  attempt
  reason_code
  detail
}

// ═══════════════════════════════════════════
// Flow & Verify
// ═══════════════════════════════════════════

actor Collector {
  can RefreshDiscovery
  can CollectLogs
  can CollectMetrics
}

command RefreshDiscovery {
  state_dir
}

command CollectLogs {
  input_id
  path
  since_offset
}

command CollectMetrics {
  target_ref
  collection_kind
  collected_at
}

flow RefreshDiscoveryFlow {
  actor Collector
  trigger RefreshDiscovery

  creates DiscoveryRefreshResult

  step Refresh {
    create DiscoveryRefreshResult {
      last_success_at = RefreshDiscovery.state_dir
    }
  }
}

verify RefreshDiscoveryVerified for flow RefreshDiscoveryFlow {
  given {
    RefreshDiscovery.state_dir = "/var/lib/warp-insight/state"
  }

  when RefreshDiscovery

  expect {
    DiscoveryRefreshResult.last_success_at == "/var/lib/warp-insight/state"
  }
}

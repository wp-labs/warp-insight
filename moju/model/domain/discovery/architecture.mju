// 发现采集域 architecture

layer Application
layer Domain
layer Infra

dependency_rule LayerDirection {
  Application -> Domain
  Domain -> Infra
  Infra -> none_external
}

module<service> Config {
  meta {
    label zh "Agent 配置"
    label en "Agent Config"
    summary zh "负责 Agent 配置契约、控制面地址、路径、执行参数、发现开关、遥测和日志输入配置。"
    tag "agent"
    tag "config"
  }

  layer Domain
  owns AgentConfigContract
  owns AgentSection
  owns ControlPlaneSection
  owns PathsSection
  owns ExecutionSection
  owns DiscoverySection
  owns TelemetrySection
  owns LogsSection
  owns LogsOutputSection
  owns LogsFileOutputSection
  owns LogsTcpOutputSection
  owns LogFileInputSection
  owns EnsuredConfigFile
  owns ConfigError
  responsible_for "Agent 配置：发现开关、采集参数、路径、输出目标"
}

module<service> Probe {
  meta {
    label zh "发现探针"
    label en "Discovery Probe"
    summary zh "负责主机、网络、端点、进程、容器和 K8s 资源发现，以及发现快照刷新和缓存。"
    tag "agent"
    tag "discovery"
  }

  layer Domain
  owns DiscoveryProbe
  owns HostDiscoveryProbe
  owns NetworkDiscoveryProbe
  owns EndpointDiscoveryProbe
  owns ProcessDiscoveryProbe
  owns ContainerDiscoveryProbe
  owns K8sDiscoveryProbe
  owns ProbeOutput
  owns DiscoveryProbeError
  owns DiscoveryRuntime
  owns DiscoveryRefreshResult
  owns SuccessfulProbeRefresh
  owns DiscoveryStoreFailure
  owns DiscoveryCachePaths
  owns DiscoveryCacheLoadFailure
  responsible_for "发现探针与运行时：探测、刷新、缓存、持久化"
}

module<pipeline> Collect {
  meta {
    label zh "采集管线"
    label en "Collection Pipeline"
    summary zh "负责日志采集、Metric 采集、多行折叠、遥测缓冲、WarpParse 摄入头和采集位点管理。"
    tag "agent"
    tag "collection"
  }

  layer Domain
  owns CollectLogs
  owns CollectMetrics
  owns FileInputConfig
  owns FileInputProcessor
  owns ProcessOutcome
  owns ProcessOutcomeKind
  owns RawFileLine
  owns ReadFromOffset
  owns StartupPosition
  owns ResumeDecision
  owns IfEmptyThen
  owns MultilineMode
  owns FoldedLine
  owns FoldResult
  owns RecordSink
  owns TelemetryRecordSink
  owns FileRecordSink
  owns TcpRecordSink
  owns TcpFraming
  owns StageResult
  owns TelemetryBuffer
  owns MetricsRuntimeSnapshot
  owns MetricsCollectionOutcome
  owns MetricsCollectionTargetSample
  owns MetricsSamplesSnapshot
  owns MetricsSampleGroup
  owns MetricsSampleRecord
  owns MetricsTargetView
  owns MetricsTargetViewEntry
  owns WarpParseIngestHead
  owns WarpParseIngestMessageKind
  owns WarpParseIngestEncoding
  owns WarpParseIngestCompression
  owns LogCheckpointState
  owns PendingMultilineState
  owns TrackedFileCheckpoint
  owns PendingCheckpoint
  owns RuntimeState
  owns CollectedReadBatch
  owns DeliveryOutcome
  responsible_for "数据采集管线：日志文件输入、多行折叠、缓冲输出、Metrics 采集、WarpParse 摄入、位点管理"
}

module<worker> Execute {
  meta {
    label zh "受控执行"
    label en "Controlled Execution"
    summary zh "负责远程 action 的本地队列、调度、执行、隔离、运行状态和进度记录。"
    tag "agent"
    tag "execution"
  }

  layer Domain
  owns SchedulerRequest
  owns SchedulerOutcome
  owns DrainRequest
  owns DrainOutcome
  owns QueueHeadContext
  owns QueueHeadDisposition
  owns ExecutionQueueState
  owns ExecutionQueueItem
  owns ExecutionQueueItemBuilder
  owns LocalExecRequest
  owns LocalExecOutcome
  owns ExitClassification
  owns QuarantineRequest
  owns RunningExecutionState
  owns RunningExecutionStateBuilder
  owns ProcessIdentityState
  owns AgentRuntimeState
  owns RuntimeMode
  owns ExecRuntimeContext
  owns ExecProgressState
  responsible_for "Action 调度执行与状态管理：队列、子进程、运行时状态、执行进度"
}

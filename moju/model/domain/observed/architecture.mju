// 被观测域 architecture

layer Application
layer Domain
layer Infra

dependency_rule LayerDirection {
  Application -> Domain
  Domain -> Infra
  Infra -> none_external
}

module Snapshot {
  meta {
    label zh "发现快照"
    label en "Discovery Snapshot"
    summary zh "负责被观测资源、目标、来源、采集候选和快照元数据的完整契约。"
    tag "observed"
    tag "snapshot"
  }

  layer Domain
  owns DiscoverySnapshotContract
  owns DiscoveryOrigin
  owns DiscoveryCacheMeta
  owns DiscoveredResource
  owns DiscoveredTarget
  owns CandidateCollectionTarget
  owns StringKeyValue
  responsible_for "发现快照的完整契约：快照结构、资源、目标、采集候选"
}

module Entity {
  meta {
    label zh "被观测实体"
    label en "Observed Entity"
    summary zh "负责进程、网络接口、IP、服务端点、容器、文件身份、socket owner 和运行时根等原始实体模型。"
    tag "observed"
    tag "entity"
  }

  layer Domain
  owns ObservedProcess
  owns ObservedNetworkInterface
  owns ObservedIpAddress
  owns ObservedServiceEndpoint
  owns ObservedContainer
  owns ObservedFileIdentity
  owns OciRuntimeSpec
  owns OciLinuxSpec
  owns ContainerRuntimeRoot
  owns ProcessSocketOwner
  owns AddressFamily
  owns SocketTableKind
  owns DiscoverySourceKind
  responsible_for "探针观测到的原始实体模型：进程、网络、容器、端点"
}

module Snapshot {
  meta {
    label zh "发现快照"
    label en "Discovery Snapshot"
    summary zh "负责被观测资源、目标、来源、采集候选和快照元数据的完整契约。"
    tag "observed"
    tag "snapshot"
  }

  layer Domain
  owns DiscoverySnapshotContract
  owns DiscoveryOrigin
  owns DiscoveryCacheMeta
  owns DiscoveredResource
  owns DiscoveredTarget
  owns CandidateCollectionTarget
  owns StringKeyValue
  responsible_for "发现快照的完整契约：快照结构、资源、目标、采集候选"
}

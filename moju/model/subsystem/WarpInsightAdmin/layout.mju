// WarpInsightAdmin WEB Layout index
//
// Keep this file at page/navigation level. Page internals and reusable
// regions live under ./layout/*.mju so GUI layout overview stays readable.

region AdminTopNavigation {
  meta {
    label zh "顶部导航"
    label en "Top Navigation"
    summary zh "WarpInsightAdmin 的顶部导航区，作为三个独立页面共享的页面级导航，提供首页、安装和控制中心入口，并展示在线业务区和操作者上下文。"
    tag "admin"
    tag "navigation"
    tag "top-navigation"
    tag "layout-index"
  }

  orientation horizontal
}

region<page> AdminHomePage {
  meta {
    label zh "首页"
    label en "Home"
    summary zh "WarpInsightAdmin 的独立首页，面向 20 到 50 个常见 Agent、最多 200 个 Agent 的客户环境，只展示存在异常的 Agent 卡片；正常 Agent 不在首页主体中显示。"
    tag "admin"
    tag "home"
    tag "page"
    tag "agent-status"
    tag "abnormal-agent-only"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AgentStatusOverviewMetrics
  contains AbnormalAgentPanel
  layout fill_remaining
}

region<page> AgentInstallPage {
  meta {
    label zh "安装"
    label en "Install"
    summary zh "WarpInsightAdmin 的独立安装页，只提供 X86-Linux 和 Arm-Linux 两个 Agent 安装代码；无需输入租户、环境或其它参数，也不展示安装说明。"
    tag "admin"
    tag "agent-install"
    tag "install-code"
    tag "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AgentInstallCodeList { slot_usecase: GetAgentInstallCode }
  layout fill_remaining
}

region<page> AgentControlCenterPage {
  meta {
    label zh "控制中心"
    label en "Control Center"
    summary zh "WarpInsightAdmin 的独立控制中心页，面向已接入 Agent，突出两个常见控制任务：暂停 Agent 和升级 Agent。"
    tag "admin"
    tag "agent-control"
    tag "page"
  }

  orientation vertical
  contains AdminTopNavigation
  contains AdminOperatorLane { slot_actor: AdminOperator }
  contains AgentControlUsecaseBoard
  layout fill_remaining
}

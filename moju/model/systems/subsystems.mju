// 系统分解：顶层子系统边界

subsystem WarpInsightAdmin {
  meta {
    label zh "控制平台"
    summary zh "中心侧控制、治理、编译、下发、跟踪与风险控制。"
    tag "control-plane"
  }

  uses module Control.AdminWebFrontend
  uses module Control.UserFacingInterface, Control.AgentFacingInterface
  uses module Control.Enrollment, Control.Identity, Control.AgentdStatusManagement
  uses module Control.AgentCommandControl
  uses module Control.Protocol, Control.Registry
}

subsystem DataPlatform {
  meta {
    label zh "数据平台"
    summary zh "中心侧数据接入、遥测协议、健康状态、采集管线与报表数据处理能力。"
    tag "data-plane"
  }

  uses module Reporting.Protocol, Reporting.Contract, Reporting.Health, Reporting.Pipeline
}

subsystem WpAgent {
  meta {
    label zh "wp-agent"
    summary zh "边缘侧发现、采集、缓冲、上送、受控执行与升级辅助。"
    tag "edge"
  }

  uses module Discovery.Config, Discovery.Probe, Discovery.Collect, Discovery.Execute
  uses module Observed.Snapshot, Observed.Entity
}
